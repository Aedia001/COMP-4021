{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.3-codex",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "draw": {
      "description": "Generate the corresponding picture",
      "mode": "subagent",
      "model": "openai/gpt-image-1",
      "prompt": "You are a picture generator.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  }
}